{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go Modules"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "Docker Images"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFiles": [".binny.yml", ".binny.yaml"],
      "groupName": "binny tools",
      "groupSlug": "binny-tools"
    }
  ],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)\\.binny\\.ya?ml$"],
      "matchStrings": [
        "-\\s*name:\\s*(?<depName>[\\w\\-]+)\\s*\\n\\s*version:\\s*\\n\\s*want:\\s*(?<currentValue>v?[\\d\\.]+)\\s*\\n\\s*method:\\s*github-release\\s*\\n\\s*with:\\s*\\n\\s*repo:\\s*(?<packageName>[\\w\\-\\.\\/]+)"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
